test-ws/
tests/fixtures/v02/*/views/

# Python local environments
# Both forms: the trailing-slash pattern matches a directory only, so a `.venv`
# SYMLINK (e.g. one pointing a git worktree at the main checkout's environment)
# is not ignored and can be committed by `git add -A`.
.venv/
.venv

# Local tool config
.vscode/
.claude/settings.local.json

# Scratch / local secrets
tmp/

# Orchestration state (non-SOT): LangGraph SQLite checkpoint DB + rejected ledger.
# Covers .construct/workflow/research-run.sqlite and .construct/research/rejected.json (D-02).
.construct/

# Secrets — never commit provider API keys / tokens.
.env
.env.*
!.env.example
